using Marqraft.Project

describe "theme menus" do
  it "renders theme defaults, then the site's saved items" do
    let external = "/private/tmp/marqraft-menu-theme-${Marqraft.Store.identifier}/menu-theme"
    Marqraft.Builtin.files("basic").entries.each do |entry|
      let (path, source) = entry
      let text = if path == "marqraft-theme.jsonc"
        source.replace("\"pageTemplates\": [", "\"menus\": [{ \"id\": \"header\", \"label\": \"Header\", \"default\": [{ \"label\": \"Home\", \"path\": \"/\" }, { \"label\": \"Docs\", \"url\": \"https://kex.run/docs\" }] }],\n  \"pageTemplates\": [")
      elif path == "page.html.ket"
        source.replace("<header class=\"site-header\">", "<header class=\"site-header\"><marqraft-content source=\"menu\" menu=\"header\"></marqraft-content>")
      else
        source
      end
      assert(FS.Directory.create(FS.Path.dirname(external + "/" + path)))
      assert(FS.File.write(external + "/" + path, text))
    end
    let root = "/private/tmp/marqraft-menu-site-${Marqraft.Store.identifier}"
    Marqraft.Scaffold.create(root, external).try
    let site = Marqraft.Project.load(root).try
    let home = site.pages.find { |page| page.path == "/" }.try
    let published = Marqraft.Theme.render(site, home, false).try
    assert(published.contains?("<ul class=\"marq-menu\"><li><a href=\"/\" aria-current=\"page\">Home</a></li><li><a href=\"https://kex.run/docs\">Docs</a></li></ul>"))
    assert(Marqraft.Theme.render(site, home, true).try.contains?("<div data-marq-menu=\"header\">"))

    let draft = Marqraft.Project.createPage(root, "Draft", "/draft/", "page", "").try
    let revision = Marqraft.Project.updateMenus(root, Digest.sha256(""), { "header": [{ "label": "Soon", "page": draft.id }, { "label": "Start", "page": home.id }] }).try
    let saved = Marqraft.Project.load(root).try
    let savedHome = saved.pages.find { |page| page.path == "/" }.try
    let output = Marqraft.Theme.render(saved, savedHome, false).try
    assert(output.contains?("<ul class=\"marq-menu\"><li><a href=\"/\" aria-current=\"page\">Start</a></li></ul>"))
    assert(Marqraft.Theme.render(saved, savedHome, true).try.contains?(">Soon</a>"))

    assert(!Marqraft.Project.updateMenus(root, Digest.sha256(""), { "header": [] }).ok?)
    assert(!Marqraft.Project.updateMenus(root, revision, { "header": [{ "label": "x", "url": "javascript:alert(1)" }] }).ok?)
    assert(!Marqraft.Project.updateMenus(root, revision, { "header": [{ "label": "x", "page": "missing" }] }).ok?)
    assert(!Marqraft.Project.updateMenus(root, revision, { "footer": [] }).ok?)
    assert(Marqraft.Project.updateMenus(root, revision, { "header": [{ "label": "Prelude", "url": "/prelude/" }] }).ok?)
  end
end
