using Marqraft.Project

describe "theme selection" do
  it "references a built-in theme by name and renders navigation and pager" do
    let root = "${FS.Directory.temporary}/marqraft-theme-${Marqraft.Store.identifier}"
    Marqraft.Scaffold.create(root, "book").try
    assert(!FS.Directory.directory?(root + "/theme"))
    let site = Marqraft.Project.load(root).try
    assert(site.themeDir.startsWith?(".marqraft/cache/themes/book-"))
    let home = site.pages.find { |page| page.path == "/" }.try
    let homeHtml = Marqraft.Theme.render(site, home, false).try
    assert(homeHtml.contains?("--marq-accent:#b52a35;"))
    assert(!homeHtml.contains?("marqraft-content"))
    let tutorial = site.pages.find { |page| page.path == "/tutorial/" }.try
    let steps = Marqraft.Project.createPage(root, "First steps", "/tutorial/first-steps/", "page", tutorial.id).try
    Marqraft.Project.setDraft(root, steps.id, false).try
    let html = Marqraft.Theme.render(Marqraft.Project.load(root).try, tutorial, false).try
    assert(html.contains?("<a href=\"/tutorial/\" aria-current=\"page\">"))
    assert(html.contains?("rel=\"next\" href=\"/tutorial/first-steps/\""))
    assert(!html.contains?("rel=\"prev\""))
  end
  it "nests new pages under a parent and keeps drafts out of the published pager" do
    let root = "${FS.Directory.temporary}/marqraft-nest-${Marqraft.Store.identifier}"
    Marqraft.Scaffold.create(root, "book").try
    let site = Marqraft.Project.load(root).try
    let tutorial = site.pages.find { |page| page.path == "/tutorial/" }.try
    let child = Marqraft.Project.createPage(root, "Variables", "/tutorial/variables/", "page", tutorial.id).try
    let reloaded = Marqraft.Project.load(root).try
    let nested = Marqraft.Data.list(Marqraft.Data.object(reloaded.navigation.last.try).try.get("children").or([])).try
    assert(Marqraft.Data.text(nested.first.try, "id", "") == child.id)
    assert(FS.File.read(root + "/content/tutorial/variables/index.md").try.contains?("## Overview"))
    let page = reloaded.pages.find { |item| item.id == tutorial.id }.try
    assert(!Marqraft.Theme.render(reloaded, page, false).try.contains?("/tutorial/variables/"))
    assert(Marqraft.Theme.render(reloaded, page, true).try.contains?("/tutorial/variables/"))
    assert(!Marqraft.Project.createPage(root, "Orphan", "/orphan/", "page", "missing").ok?)
  end
  it "ejects the built-in theme into the project and switches to it" do
    let root = "${FS.Directory.temporary}/marqraft-eject-${Marqraft.Store.identifier}"
    Marqraft.Scaffold.create(root, "basic").try
    assert(Marqraft.Scaffold.eject(root).try == "themes/basic")
    assert(FS.File.file?(root + "/themes/basic/starters/page.md"))
    assert(Marqraft.Project.load(root).try.themeDir == "themes/basic")
    assert(!Marqraft.Scaffold.eject(root).ok?)
  end
  it "validates every setting, not only the first" do
    let fields = JSON.parse("[{\"name\":\"a\",\"type\":\"text\"},{\"name\":\"size\",\"type\":\"number\",\"min\":1,\"max\":5}]").try
    assert(Marqraft.API.validateSettings({ "a": "x", "size": "3" }, Marqraft.Data.list(fields).try).ok?)
    assert(!Marqraft.API.validateSettings({ "a": "x", "size": "9" }, Marqraft.Data.list(fields).try).ok?)
    assert(!Marqraft.API.validateSettings({ "a": "x", "zzz": "1" }, Marqraft.Data.list(fields).try).ok?)
  end
  it "uses a theme kept outside the project and picks up its changes" do
    let external = "${FS.Directory.temporary}/marqraft-external-theme-${Marqraft.Store.identifier}/docs-theme"
    Marqraft.Builtin.files("basic").entries.each do |entry|
      let (path, source) = entry
      assert(FS.Directory.create(FS.Path.dirname(external + "/" + path)))
      assert(FS.File.write(external + "/" + path, source))
    end
    let root = "${FS.Directory.temporary}/marqraft-external-site-${Marqraft.Store.identifier}"
    Marqraft.Scaffold.create(root, external).try
    assert(Marqraft.Data.text(Marqraft.Data.read(root + "/marqraft.jsonc").try, "theme", "") == external)
    let site = Marqraft.Project.load(root).try
    assert(site.themeDir.startsWith?(".marqraft/cache/themes/docs-theme-"))
    assert(FS.File.write(external + "/style.css", "body{color:#123456}"))
    let changed = Marqraft.Project.load(root).try
    assert(changed.themeDir != site.themeDir)
    let home = changed.pages.find { |page| page.path == "/" }.try
    assert(Marqraft.Theme.render(changed, home, false).try.contains?("body{color:#123456}"))
    assert(!Marqraft.Scaffold.create(root + "-missing", "${FS.Directory.temporary}/no-such-theme").ok?)
  end
  it "highlights Kex code in published fences" do
    let html = Markdown.Highlight.highlight("let name = \"x<y\"\nIO.printLine(name)")
    assert(html.contains?("<span class=\"tok-keyword\">let</span>"))
    assert(html.contains?("<span class=\"tok-type\">IO</span>"))
    assert(html.contains?("x&lt;y"))
    assert(Markdown.toHtml("```kex\nlet a = 1\n```").contains?("tok-keyword"))
    assert(!Markdown.toHtml("```\nlet a = 1\n```").contains?("tok-keyword"))
  end
end
