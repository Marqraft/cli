module Marqraft.Build

using Marqraft.Document, only: [Page]
using Marqraft.Project, only: [Site, pagePath]
using Marqraft.Routes, only: [SiteOutput]

foul run(directory: String) -> Void or! String do
  let site = Marqraft.Project.load(directory).try
  let destination = Marqraft.Store.safePath(site.root, "dist").try
  let ownership = ".marqraft/cache/dist-owned"
  if FS.Directory.directory?(destination) && !FS.File.file?(site.root + "/" + ownership)
    return Error("dist already exists and was not created by Marqraft")
  end
  checkDraftLinks(site).try
  let outputs = Marqraft.Routes.all(site).try
  let stage = ".marqraft/cache/build-${Marqraft.Store.identifier}"
  let stagePath = Marqraft.Store.safePath(site.root, stage).try
  return Error("cannot create build staging directory") if !FS.Directory.create(stagePath)
  firstError(outputs.map { |output| write(site, stage, output) }).try
  let backup = site.root + "/.marqraft/cache/previous-${Marqraft.Store.identifier}"
  let existing = FS.Directory.directory?(destination)
  return Error("cannot move previous build") if existing && !FS.File.rename(destination, backup)
  if !FS.File.rename(stagePath, destination)
    let _ = existing && FS.File.rename(backup, destination)
    return Error("cannot publish staged build")
  end
  Marqraft.Store.write(site.root, ownership, Digest.sha256(site.root)).try
  IO.printLine("Built ${outputs.filter { |output| output.kind == "page" }.count} page(s) in ${destination}")
  return Ok(())
end

# A published page cannot link to a draft: the draft is not built, so the
# link would break.
let checkDraftLinks(site: Site) -> Void or! String do
  let drafts = site.pages.filter { |page| page.draft? }
  let broken = site.pages.filter { |page| !page.draft? }.flatMap { |page| drafts.filter { |draft| page.body.contains?("(${pagePath(draft)})") }.map { |draft| "${page.file}: link points to excluded draft ${pagePath(draft)}" } }
  return broken.empty? then Ok(()) else Error(broken.first.try)
end

# One output into the staging directory: a page rendered for publishing,
# the search index, or a file copied verbatim.
foul write(site: Site, stage: String, output: SiteOutput) -> Void or! String do
  let relative = stage + "/" + output.dest
  if output.kind == "page"
    let page = Marqraft.Project.page(site, output.pageId).try
    Marqraft.Store.write(site.root, relative, Marqraft.Theme.render(site, page, false).try).try
    IO.printLine("  ${pagePath(page)}")
    return Ok(())
  end
  if output.kind == "search"
    Marqraft.Store.write(site.root, relative, Marqraft.Search.index(site).try).try
    return Ok(())
  end
  let target = Marqraft.Store.safePath(site.root, relative).try
  return Error("cannot create a directory for ${output.dest}") if !FS.Directory.create(FS.Path.dirname(target))
  let copied = FS.File.writeBytes(target, FS.File.readBytes(Marqraft.Store.safePath(site.root, output.source).try).try)
  return Error("cannot copy ${output.label} ${output.dest}") if !copied
  return Ok(())
end

# `.try` inside an `each` block returns from the block, not from the
# function: a page that failed to render, or a file that failed to copy, used
# to leave a silently incomplete dist/ behind a successful build.
let firstError(results: [Void or! String]) -> Void or! String do
  return Ok(()) if results.empty?
  match results.first.try do
    Error(message) => Error(message)
    Ok(_) => firstError(results.drop(1))
  end
end
