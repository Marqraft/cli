module Marqraft.Builtin

# Themes shipped inside marq. A site selects one by name in marqraft.jsonc and
# never copies its files, so switching themes or upgrading marq changes the
# look without touching content. `marq eject-theme` copies one into a project.
let names -> [String] = ["book", "basic"]

let files(name: String) -> {String: String} do
  return basic if name == "basic"
  return book
end

let book -> {String: String} = {
  "marqraft-theme.jsonc": Kex.embed("../../themes/book/marqraft-theme.jsonc"),
  "style.css": Kex.embed("../../themes/book/style.css"),
  "page.html.ket": Kex.embed("../../themes/book/page.html.ket"),
  "landing.html.ket": Kex.embed("../../themes/book/landing.html.ket"),
  "starters/page.md": Kex.embed("../../themes/book/starters/page.md"),
  "starters/landing.md": Kex.embed("../../themes/book/starters/landing.md"),
  "assets/favicon.svg": Kex.embed("../../themes/book/assets/favicon.svg")
}

let basic -> {String: String} = {
  "marqraft-theme.jsonc": Kex.embed("../../themes/basic/marqraft-theme.jsonc"),
  "style.css": Kex.embed("../../themes/basic/style.css"),
  "page.html.ket": Kex.embed("../../themes/basic/page.html.ket"),
  "landing.html.ket": Kex.embed("../../themes/basic/landing.html.ket"),
  "starters/page.md": Kex.embed("../../themes/basic/starters/page.md"),
  "starters/landing.md": Kex.embed("../../themes/basic/starters/landing.md"),
  "assets/favicon.svg": Kex.embed("../../themes/basic/assets/favicon.svg")
}

