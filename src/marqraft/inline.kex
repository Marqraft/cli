module Marqraft.Inline

using Parsing

let toHtml(text: String) -> String do
  return loopText(Input { input: text }, "")
end

let loopText(cursor: Input, output: String) -> String do
  return output if cursor.atEnd?
  let text = cursor.remaining
  if text.startsWith?("\\") && text.count > 1
    return loopText(cursor.advanceBy(2), output + Marqraft.Content.escape(text.drop(1).take(1)))
  end
  if text.startsWith?("`")
    let (fence, afterFence) = cursor.takeWhile { |c| c == '`' }
    let endAt = find(afterFence.remaining, fence, 0)
    if endAt.set?
      let literal = afterFence.remaining.take(endAt.try)
      let normalized = literal.startsWith?(" ") && literal.endsWith?(" ") && literal.trim != "" then literal.drop(1).take(literal.count - 2) else literal
      return loopText(afterFence.advanceBy(endAt.try + fence.count), output + "<code>${Marqraft.Content.escape(normalized)}</code>")
    end
  end
  let image? = text.startsWith?("![")
  if image? || text.startsWith?("[")
    let opening = image? then 2 else 1
    let labelEnd = find(text, "](", opening)
    if labelEnd.set?
      let urlStart = labelEnd.try + 2
      let urlEnd = find(text, ")", urlStart)
      if urlEnd.set?
        let label = text.drop(opening).take(labelEnd.try - opening)
        let url = Marqraft.Content.safeURL(text.drop(urlStart).take(urlEnd.try - urlStart))
        let html = image? then "<img src=\"${Marqraft.Content.escape(url)}\" alt=\"${Marqraft.Content.escape(label)}\">" else "<a href=\"${Marqraft.Content.escape(url)}\">${toHtml(label)}</a>"
        return loopText(cursor.advanceBy(urlEnd.try + 1), output + html)
      end
    end
  end
  let marker = if text.startsWith?("**")
    "**"
  elif text.startsWith?("~~")
    "~~"
  elif text.startsWith?("*")
    "*"
  elif text.startsWith?("_")
    "_"
  else
    ""
  end
  if marker != ""
    let closing = find(text, marker, marker.count)
    if closing.set?
      let tag = marker == "**" then "strong" else (marker == "~~" then "s" else "em")
      let inner = text.drop(marker.count).take(closing.try - marker.count)
      return loopText(cursor.advanceBy(closing.try + marker.count), output + "<${tag}>${toHtml(inner)}</${tag}>")
    end
  end
  return loopText(cursor.advance, output + Marqraft.Content.escape(text.take(1)))
end

# Position of needle at or after at, in characters. Splitting is linear,
# where comparing a fresh suffix at every position was quadratic.
let find(text: String, needle: String, at: Integer) -> Integer? do
  return None if at + needle.count > text.count
  let parts = text.drop(at).split(needle)
  return None if parts.count < 2
  return Just(at + parts.first.or("").count)
end
