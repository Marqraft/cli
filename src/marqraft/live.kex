module Marqraft.Live

# `marq dev` keeps the loaded site in memory and tells every open editor
# when it changes, instead of loading the site from disk for each request
# and having each editor poll for changes.
#
# The site lives in a persistent_term, so every request reads it without
# copying. The server reloads it after its own authoring actions change
# files, and when the fingerprint of the project's files changes on disk
# (an external editor, a generated reference, another browser), and
# announces each reload to the Listeners over the /__marqraft/live
# WebSocket.

using Marqraft.Project, only: [Site]
using Net.HTTP.WebSocket, only: [Connection, Message, Text, BinaryMessage, CloseMessage]

# Every open editor, and the pages being edited together.
#
# Several editors can edit one page at once: each keeps a Yjs document, and
# the hub only relays and keeps the updates they send, as opaque bytes — Yjs
# updates merge in any order, so the server never needs to understand them.
# Frames from an editor start with a kind byte:
#
#   0  a document update: kept for the page and passed to its other editors
#   1  cursors and names (Yjs awareness): passed on, never kept
#   2  the page's whole document, compacted by its saver: replaces the kept
#      updates
#
# The first editor on a page seeds the document from the page as saved, and
# one editor per page (the saver) writes it to disk; when the saver leaves,
# another editor on the page takes over. A page nobody edits any more is
# forgotten: its saver saved it.
record Hub do
  # Connection id -> socket, for every open editor.
  sockets : {String: Connection} = {}
  # Connection id -> the page it edits, once it joined one.
  pages : {String: String} = {}
  # Page id -> the frames that make up its document, in arrival order.
  logs : {String: [Binary]} = {}
  # Page id -> the connection that saves it.
  savers : {String: String} = {}
  # Connection id -> its number among the editors on its page (Instance 1, 2, ...).
  numbers : {String: Integer} = {}
end

serving Hub do
  slot connect(id: String, socket: Connection) -> Void do
    new.sockets = @sockets.put(id, socket)
    return new
  end

  # An editor opens a page. The first one seeds the shared document and saves
  # it; a later one is sent what the document holds so far. Each editor on a
  # page gets the lowest number no other editor on it has.
  foul slot enter(id: String, page: String) -> Void do
    let seed = !@pages.values.contains?(page)
    let taken = @pages.filter { |_, edited| edited == page }.keys.map { |editor| @numbers.get(editor).or(0) }
    let number = firstFree(taken, 1)
    new.numbers = @numbers.put(id, number)
    new.pages = @pages.put(id, page)
    new.logs = seed then @logs.put(page, []) else @logs
    new.savers = seed then @savers.put(page, id) else @savers
    let saver = new.savers.get(page).or("") == id
    match @sockets.get(id) do
      Just(socket) => do
        let _ = deliver(socket, Text("{\"type\":\"joined\",\"seed\":${seed},\"saver\":${saver},\"instance\":${number}}"))
        new.logs.get(page).or([]).each { |frame| deliver(socket, BinaryMessage(frame)) }
      end
      None => Void
    end
    return new
  end

  foul slot relay(id: String, frame: Binary) -> Void do
    let page = @pages.get(id).or("")
    let kind = frame.take(1).hex
    if !page.empty? && kind == "02" && @savers.get(page).or("") == id
      new.logs = @logs.put(page, [frame])
    elif !page.empty? && (kind == "00" || kind == "01")
      new.logs = kind == "00" then @logs.put(page, @logs.get(page).or([]) + [frame]) else @logs
      let others = @pages.filter { |editor, edited| edited == page && editor != id }.keys
      others.each { |other| @sockets.get(other).map { |socket| deliver(socket, BinaryMessage(frame)) } }
    end
    return new
  end

  # An editor closes its page or disconnects: the page's saver role passes
  # to an editor still on it.
  foul slot disconnect(id: String) -> Void do
    let page = @pages.get(id).or("")
    new.sockets = @sockets.delete(id)
    new.pages = @pages.delete(id)
    new.numbers = @numbers.delete(id)
    let others = new.pages.filter { |_, edited| edited == page }.keys
    if !page.empty? && others.empty?
      new.logs = @logs.delete(page)
      new.savers = @savers.delete(page)
    elif !page.empty? && @savers.get(page).or("") == id
      let successor = others.first.or("")
      new.savers = @savers.put(page, successor)
      new.sockets.get(successor).map { |socket| deliver(socket, Text("{\"type\":\"saver\"}")) }
    end
    return new
  end

  foul slot broadcast(text: String) -> Void do
    new.sockets = @sockets.filter { |_, socket| deliver(socket, Text(text)) }
    return new
  end
end

let firstFree(taken: [Integer], number: Integer) -> Integer = taken.contains?(number) then firstFree(taken, number + 1) else number

# Sends one message to an editor, true when it went out. Connection.send only
# type-checks with an inline Text(...): given any other Message — a
# BinaryMessage, or a value typed Message — Kex's checker resolves it to
# another `send`. The intrinsic it wraps is unambiguous.
foul deliver(socket: Connection, message: Message) -> Bool = Kex.Intrinsic.NetWebSocket.send(socket, message).ok?

# One editor's connection, for as long as it stays open: it may join a page
# ({"type": "join", "page": id}) and send document and cursor frames.
foul serveEditor(hub: Server<Hub>, socket: Connection) -> Void do
  let id = Marqraft.Store.identifier
  hub.connect(id, socket)
  loop do
    match socket.receiveMessage do
      Ok(Text(text)) => do
        let message = Marqraft.Data.object(Marqraft.Data.decode(text).or({})).or({})
        if Marqraft.Data.text(message, "type", "") == "join"
          hub.enter(id, Marqraft.Data.text(message, "page", ""))
        end
      end
      Ok(BinaryMessage(frame)) => hub.relay(id, frame)
      Ok(CloseMessage(_, _)) => break
      Ok(_) => Void
      Error(_) => break
    end
  end
  hub.disconnect(id)
end

# The loaded site of one project, shared by every request process.
foul loadedSite(root: String) -> Process.Shared<Site> = Process.Shared.named("marqraft_site:${root}")

# The site as last loaded, loading it on first use.
foul site(root: String) -> Site or! String do
  let cached: Site? = loadedSite(root).get
  match cached do
    Just(loaded) => return Ok(loaded)
    None => return refresh(root)
  end
end

# Reloads the site from disk and keeps it. A site that fails to load keeps
# the last good one being served.
foul refresh(root: String) -> Site or! String do
  let loaded = Marqraft.Project.load(root).try
  loadedSite(root).put(loaded)
  return Ok(loaded)
end

let changed -> String = "{\"type\":\"changed\"}"

# A hash of path, modification time and size of the files the site is
# built from: the config, the authored content and uploads, the navigation
# and menus and the theme, plus with `mounts?` every mounted directory or
# file. Mounted output is large and changes only when it is regenerated, so
# the watcher checks it less often than what authors edit.
foul fingerprint(root: String, mounts?: Bool) -> String do
  let config = Marqraft.Data.object(Marqraft.Data.read(root + "/marqraft.jsonc").or({})).or({})
  let theme = Marqraft.Data.text(config, "theme", "")
  let declared = Marqraft.Data.list(config.get("mounts").or([])).or([]).map { |mount| Marqraft.Data.text(mount, "dir", "") + Marqraft.Data.text(mount, "file", "") }
  let mounted = mounts? then declared else []
  let external = theme.startsWith?("/") || theme.startsWith?("../") then [theme] else []
  let local = theme.startsWith?("./") then [theme.drop(2)] else []
  let roots = ["marqraft.jsonc", ".marqraft/navigation.json", ".marqraft/menus.json", "content", "public"] + local + mounted
  let inside = roots.flatMap { |relative| stamps(root + "/" + relative, relative) }
  let outside = external.flatMap { |path| stamps(path.startsWith?("/") then path else root + "/" + path, path) }
  # A hash of (path, mtime, size) for every file: no string per file.
  return "${Kex.hash(inside + outside)}"
end

# One lstat per file, and a plain directory walk: this runs twice a second
# over every file of the site, so it asks the file system once per entry. A
# symlink is stamped as the link, never followed: the site refuses them
# anyway (Store.tree).
foul stamps(path: String, label: String) -> [Any] do
  let info = match FS.File.info(path) do
    Ok(found) => found
    Error(_) => return []
  end
  if info.kind == :directory
    let names = FS.Directory.list(path).or([]).filter { |name| !name.startsWith?(".") && name != "node_modules" }
    return names.flatMap { |name| stamps(path + "/" + name, label + "/" + name) }
  end
  let stamp: Any = (label, info.modified, info.size)
  return [stamp]
end
