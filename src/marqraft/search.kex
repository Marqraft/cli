module Marqraft.Search

using Marqraft.Project, only: [Site]
using Marqraft.Document, only: [Page]
using Marqraft.Mounts, only: [Mount, MountVersion]

# The site's search index, opt-in with "search": "/search.json" in
# marqraft.jsonc: served by `marq dev` and written by `marq build`. One entry
# per published authored page and one per h2/h3 section, then the entries of
# every mount that names its producer's index ("search" on the mount), from
# the mount's newest version. Entries keep the producer's shape (kind,
# name, qualifiedName, summary, signatures, types — Tey docgen's) and gain a
# site `url`, plus `collection` and `version` for generated ones, so a theme
# searches one file and needs to know nothing about the producer.
let indexPath(site: Site) -> String = Marqraft.Data.text(site.config, "search", "")

foul validate(site: Site) -> Void or! String do
  let url = indexPath(site)
  return Ok(()) if url.empty?
  return Error("search must be a file path such as /search.json") if !Marqraft.Mounts.filePath?(url)
  let taken = site.mounts.any? { |mount| url.startsWith?(mount.url) }
  return Error("search index collides with a mount: ${url}") if taken
  return Ok(())
end

foul index(site: Site) -> String or! String do
  let blocks = Marqraft.Data.list(site.theme.get("blocks").or([])).try
  let pages = site.pages.filter { |page| !page.generated? && !page.draft? }
  let none: [Any] = []
  let authored = pages.reduce(none) do |all, page|
    all + pageEntries(site, page, Marqraft.Content.render(page.body, false, site.root, blocks))
  end
  let generated = site.mounts.reduce(none) { |all, mount| all + mountEntries(site, mount) }
  return Ok(Marqraft.Data.encode({ "entries": authored + generated }))
end

# A producer's entries name their page relative to the version directory
# ("urlPath", with an optional "anchor"); a missing or unreadable index
# contributes nothing.
foul mountEntries(site: Site, mount: Mount) -> [Any] do
  return [] if mount.search.empty? || mount.dir.empty?
  match Marqraft.Mounts.newestVersion(mount) do
    None => []
    Just(version) => do
      let file = Marqraft.Store.safePath(site.root, "${mount.dir}/${version.name}/${mount.search}").or("")
      let raw = Marqraft.Data.object(Marqraft.Data.read(file).or({})).or({})
      let entries = Marqraft.Data.list(raw.get("entries").or([])).or([])
      entries.map { |entry| producerEntry(entry, mount, version) }
    end
  end
end

let producerEntry(entry: Any, mount: Mount, version: MountVersion) -> Any do
  let fields = Marqraft.Data.object(entry).or({})
  let page = Marqraft.Data.text(fields, "urlPath", "")
  let anchor = Marqraft.Data.text(fields, "anchor", "")
  let url = version.url + (page.empty? then "" else page + "/") + (anchor.empty? then "" else "#" + anchor)
  let merged: Any = fields.put("url", url).put("collection", mount.title).put("version", version.name)
  return merged
end

foul pageEntries(site: Site, page: Page, html: String) -> [Any] do
  let context = collectionTitle(site, page)
  let chunks = html.replace("<h3 id=\"", "<h2 id=\"").split("<h2 id=\"")
  let lead = plain(chunks.first.or(""))
  let summary = page.description.empty? then clip(lead, 200) else page.description
  let head: Any = { "kind": "page", "name": page.title, "qualifiedName": context, "summary": summary, "url": Marqraft.Theme.pathOf(page), "text": clip(lead, 2000) }
  let sections = chunks.drop(1).map do |chunk|
    let id = chunk.split("\"").first.or("")
    # id="values">Values</h2> ...: the heading's text, then what follows
    # its closing tag.
    let rest = chunk.drop(id.count + 2)
    let heading = plain(rest.split("</h").first.or(""))
    let after = rest.split("</h").drop(1).join("</h")
    let body = plain(after.split(">").drop(1).join(">"))
    let entry: Any = { "kind": "section", "name": heading, "qualifiedName": page.title, "summary": clip(body, 200), "url": "${Marqraft.Theme.pathOf(page)}#${id}", "text": clip(body, 2000) }
    entry
  end
  return [head] + sections
end

let collectionTitle(site: Site, page: Page) -> String do
  let id = Marqraft.Navigation.collectionOf(site.navigation, page.id).map { |node| node.id }.or("")
  return "" if id.empty? || id == page.id
  match site.pages.find { |item| item.id == id } do
    Just(item) => Marqraft.Theme.titleOf(item)
    None => ""
  end
end

# Text without markup: tags dropped, entities decoded, whitespace collapsed.
let plain(html: String) -> String do
  let parts = html.split("<")
  let text = ([parts.first.or("")] + parts.drop(1).map { |part| part.split(">").drop(1).join(">") }).join(" ")
  let decoded = text.replace("&lt;", "<").replace("&gt;", ">").replace("&quot;", "\"").replace("&#39;", "'").replace("&amp;", "&")
  return decoded.split("\n").join(" ").split(" ").filter { |word| !word.empty? }.join(" ")
end

let clip(text: String, limit: Integer) -> String do
  return text.count <= limit then text else text.take(limit) + "…"
end
