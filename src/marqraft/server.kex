module Marqraft.Server

using Marqraft.Document, only: [Page]
using Marqraft.Project, only: [Site]
using URI
using Rodolfo
using Marqraft.API, only: [Workspace]
using Net.HTTP.WebSocket, only: [Connection, CloseMessage]

foul start(directory: String, port: Integer) -> Void or! String do
  let site = Marqraft.Project.load(directory).try
  let root = site.root
  let token = Marqraft.Store.identifier
  let workspace = Process.spawn(Workspace { root })
  Marqraft.Live.refresh(root).try
  let hub = Process.spawn(Marqraft.Live.Hub {})
  # Twice a second: when the project's files changed on disk, reload the
  # site and tell every open editor. Mounted output is checked every third
  # second: it is large, and changes only when it is regenerated.
  let _ = Task.start do
    var authored = Marqraft.Live.fingerprint(root, false)
    var everything = Marqraft.Live.fingerprint(root, true)
    var tick = 0
    loop do
      Task.sleep(500.millisecond)
      tick = tick + 1
      let nowAuthored = Marqraft.Live.fingerprint(root, false)
      let nowEverything = tick % 6 == 0 then Marqraft.Live.fingerprint(root, true) else everything
      if nowAuthored != authored || nowEverything != everything
        authored = nowAuthored
        everything = tick % 6 == 0 then nowEverything else Marqraft.Live.fingerprint(root, true)
        if Marqraft.Live.refresh(root).ok?
          hub.broadcast(Marqraft.Live.changed)
        end
      end
    end
  end
  let router = Rodolfo.router do
    get "/__marqraft/project" do |env|
      if !allowedHost?(env, port)
        textReply(403, "forbidden host")
      else
        jsonResult(Marqraft.API.metadata(root))
      end
    end
    get "/__marqraft/document/:id" do |env|
      if !allowedHost?(env, port)
        textReply(403, "forbidden host")
      else
        jsonResult(Marqraft.API.document(root, env.param("id").or("")))
      end
    end
    post "/__marqraft/:action" do |env|
      authorized?(env, port, token) then act(env, root, workspace, hub) else textReply(403, "invalid authoring session or origin")
    end
    # Open editors hear here when the site changes, instead of polling.
    ws "/__marqraft/live" do |env, socket|
      allowedHost?(env, port) then Marqraft.Live.serveEditor(hub, socket) else socket.close
    end
    get "/__marqraft/editor.js" do |_|
      Response.Text { body: Kex.embed("../../assets/editor.js"), headers: noCacheWith("text/javascript; charset=utf-8") }
    end
    get "/__marqraft/editor.css" do |_|
      Response.Text { body: Kex.embed("../../assets/marqraft-author.css"), headers: noCacheWith("text/css; charset=utf-8") }
    end
    get "/" do |env|
      allowedHost?(env, port) then Marqraft.Server.serve(root, "", token) else textReply(403, "forbidden host")
    end
    get "/*path" do |env|
      allowedHost?(env, port) then Marqraft.Server.serve(root, env.param("path").or(""), token) else textReply(403, "forbidden host")
    end
  end
  IO.printLine("Marqraft: http://localhost:${port}")
  # Browsers may resolve localhost to either loopback, so serve both. A machine
  # without IPv6 still serves on 127.0.0.1.
  let ipv6 = router.background("::1", port)
  IO.printError("marq: IPv6 loopback unavailable; use http://127.0.0.1:${port}\n") if !ipv6.ok?
  router.start("127.0.0.1", port).try
  return Ok(())
end

# One authoring action. A body that is not text, or a workspace that cannot
# be reached, is answered as a 500.
foul act(env: Rodolfo.Context, root: String, workspace: Server<Workspace>, hub: Server<Marqraft.Live.Hub>) -> Rodolfo.Response.Text | Rodolfo.Response.JSON do
  let body = env.request.body.to(String).try
  return textReply(413, "request too large") if body.count > 12000000
  if env.param("action").or("") == "assist"
    let answer = Marqraft.API.assist(root, body)
    return jsonReply(answer.status, answer.body)
  end
  let result = workspace.invoke(env.param("action").or(""), body).try
  # A successful action changed files: the next request, and every
  # open editor, sees the site as it is now.
  if result.status == 200 && Marqraft.Live.refresh(root).ok?
    hub.broadcast(Marqraft.Live.changed)
  end
  return jsonReply(result.status, result.body)
rescue |error|
  return textReply(500, "${error}")
end

let noCacheFields -> [(String, String)] = [("Cache-Control", "no-store"), ("X-Content-Type-Options", "nosniff")]

# The fields are fixed and valid, so building them cannot fail; the rescue
# only satisfies the checker.
let noCache -> Net.HTTP.Headers do
  Net.HTTP.Headers.from(noCacheFields).try
rescue |_reason|
  Net.HTTP.Headers.empty
end

# The no-cache headers plus a content type, for the embedded editor assets.
let noCacheWith(contentType: String) -> Net.HTTP.Headers do
  Net.HTTP.Headers.from(noCacheFields + [("Content-Type", contentType)]).try
rescue |_reason|
  noCache
end

let allowedHost?(env: Rodolfo.Context, port: Integer) -> Bool do
  let host = env.request.headers.get("Host").or("")
  return ["localhost:${port}", "127.0.0.1:${port}", "[::1]:${port}"].contains?(host)
end

let authorized?(env: Rodolfo.Context, port: Integer, token: String) -> Bool do
  return false if !allowedHost?(env, port)
  let origin = env.request.headers.get("Origin").or("")
  let allowedOrigin = match URI.URL.parse(origin) do
    Ok(url) => ["http://localhost:${port}", "http://127.0.0.1:${port}", "http://[::1]:${port}"].contains?(url.string)
    Error(_) => false
  end
  return false if !allowedOrigin
  return env.request.headers.get("X-Marqraft-Session").or("") == token
end

foul jsonResult(result: {String: Any} or! String) -> Rodolfo.Response.JSON do
  match result do
    Ok(data) => Response.JSON { body: Marqraft.Data.encode(data), headers: noCache }
    Error(message) => do
      let error = Marqraft.API.failure(message)
      Response.JSON { status: error.status, body: error.body, headers: noCache }
    end
  end
end

# One request, answered from the site as it is on disk now, so every edit
# shows on the next reload: a page (with the authoring UI), the search
# index, or a file.
foul serve(root: String, relative: String, token: String) -> Rodolfo.Response.Text | Rodolfo.Response.JSON | Rodolfo.Response.HTML | Rodolfo.Response.Raw do
  let site = Marqraft.Live.site(root).try
  match Marqraft.Routes.find(site, relative) do
    None => return textReply(404, "Not found")
    Just(output) => do
      return renderPage(site, Marqraft.Project.page(site, output.pageId).try, token) if output.kind == "page"
      return jsonReply(200, Marqraft.Search.index(site).try) if output.kind == "search"
      let path = Marqraft.Store.safePath(root, output.source).try
      return Response.Raw { body: FS.File.readBytes(path).try, contentType: Marqraft.Theme.mimeType(path), headers: noCache }
    end
  end
rescue |error|
  return textReply(500, "${error}")
end

# Generated pages render view-only: no editing bindings ever attach to them.
foul renderPage(site: Site, page: Page, token: String) -> Rodolfo.Response.HTML | Rodolfo.Response.Text do
  let html = Marqraft.Theme.render(site, page, !page.generated?).try
  let generated = page.generated? then "<meta name=\"marq-generated\" content=\"${Marqraft.Content.escape(page.title)}\">" else ""
  let author = "<meta name=\"marq-token\" content=\"${token}\"><meta name=\"marq-page\" content=\"${Marqraft.Content.escape(page.id)}\">${generated}<link rel=\"stylesheet\" href=\"/__marqraft/editor.css\"><div id=\"marq-chrome\"></div><script src=\"/__marqraft/editor.js\" defer></script>"
  return Response.HTML { body: html.replace("</body>", author + "</body>"), headers: noCache }
rescue |error|
  return textReply(500, "${error}")
end

let textReply(status: Integer, body: String) -> Rodolfo.Response.Text = Response.Text { status, body, headers: noCache }

let jsonReply(status: Integer, body: String) -> Rodolfo.Response.JSON = Response.JSON { status, body, headers: noCache }
